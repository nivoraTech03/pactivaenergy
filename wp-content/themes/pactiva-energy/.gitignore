# ==============================================================================
# PACTIVA ENERGY THEME — .gitignore
# ==============================================================================

# Node dependencies
node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sensitive & environment files
.env
.env.*
*.env

# Cache & Build caches
.cache/
.parcel-cache/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Editor & IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Backups & archives
*.zip
*.tar.gz
*.sql
